+% Header of a file: name on the left and hash + line count flush right on the
+% same line, the include list right after the name, then a thin rule. If that
+% does not fit in one line, the hash and line count go on a line of their own.
+\newcommand{\kactltitle}[1]{%
+	\vspace{2pt}\nobreak
+	\begingroup\parfillskip\z@skip % parskip's parfill would leave 30pt at the right
+	\def\kt@incl{\ifthenelse{\equal{\@leftcaption}{}}{}{\hspace{1.2em}{\tiny\texttt{\@leftcaption}}}}%
+	\sbox\z@{{\large #1}\kt@incl\hspace{1em}\mbox{\tiny\@rightcaption}}%
+	\par\noindent{\large #1}\kt@incl
+	\ifdim\wd\z@>\linewidth % does not fit: hash and lines on a new line, flush right
+		\par\nobreak\parskip\z@skip\noindent
+	\fi
+	\hspace*{\fill}\mbox{\tiny\@rightcaption}\par\nobreak
+	\endgroup
+	\ifthenelse{\boolean{hasdescription}\or\boolean{hasusage}\or\boolean{hastime}\or\boolean{hasmemory}}%
+		{\vspace{1pt}\nointerlineskip\hrule height 0.3pt\nobreak\vspace{1.5pt}\nobreak}%
+		{\vspace{1.5pt}\nobreak}%
+}
+
 \newcommand{\import}[1]{
 	\input{"\@kactldir/#1"}
 }
