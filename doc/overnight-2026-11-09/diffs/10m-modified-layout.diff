+% Header of a file: name on the left and hash + line count flush right on the
+% same line, the include list under the name, then a thin rule.
+\newcommand{\kactltitle}[1]{%
+	\vspace{2pt}\nobreak
+	\par\noindent{\large #1}\hfill{\tiny\@rightcaption}%
+	\ifthenelse{\equal{\@leftcaption}{}}{}{\break{\tiny\texttt{\@leftcaption}}}\par\nobreak
+	\ifthenelse{\boolean{hasdescription}\or\boolean{hasusage}\or\boolean{hastime}\or\boolean{hasmemory}}%
+		{\vspace{1pt}\nointerlineskip\hrule height 0.3pt\nobreak\vspace{1.5pt}\nobreak}%
+		{\vspace{1.5pt}\nobreak}%
+}
+
 \newcommand{\import}[1]{
 	\input{"\@kactldir/#1"}
 }
