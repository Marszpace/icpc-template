-\long\def\@makecaption#1#2{
-	\vspace{-3pt}
-	\ifthenelse{\boolean{hasdescription}}{\codeheader{Description}{\@defdescription}}{}
-	\ifthenelse{\boolean{hasusage}}{\codeheader{Usage}{\@defusage}}{}
-	\ifthenelse{\boolean{hasmemory}}{\codeheader{Memory}{\@defmemory}}{}
-	\ifthenelse{\boolean{hastime}}{\codeheader{Time}{\@deftime}}{}
-	\ifthenelse{\boolean{hasleftcaption}}{\vspace{0pt}}{\vspace{-5pt}}
-	\tiny
-	\texttt{\@leftcaption} \hfill \@rightcaption
+\long\def\@makecaption#1#2{%
+	\nobreak % the anchor whatsit before this would allow a break at the next glue
+	\ifthenelse{\boolean{hasdescription}}%
+		{\ifthenelse{\boolean{hastime}}%
+			{\codeheader{Description}{\@defdescription{} \textbf{Time:} \@deftime}}%
+			{\codeheader{Description}{\@defdescription}}}%
+		{\ifthenelse{\boolean{hastime}}{\codeheader{Time}{\@deftime}}{}}%
+	\ifthenelse{\boolean{hasmemory}}{\codeheader{Memory}{\@defmemory}}{}%
+	\ifthenelse{\boolean{hasusage}}{\codeheader{Usage}{\@defusage}}{}%
+	\ifthenelse{\boolean{hasdescription}\or\boolean{hasusage}\or\boolean{hastime}\or\boolean{hasmemory}}%
+		{\nobreak\vspace{2.5pt}\nobreak}{}%
 }
 
