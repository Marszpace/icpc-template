diff --git a/stress-tests/geometry/3dHull.cpp b/stress-tests/geometry/3dHull.cpp
new file mode 100644
index 0000000..208da39
--- /dev/null
+++ b/stress-tests/geometry/3dHull.cpp
@@ -0,0 +1,55 @@
+#include "../utilities/template.h"
+
+#include "../../content/geometry/3dHull.h"
+#include "../../content/geometry/PolyhedronVolume.h"
+
+double rd() { return rand() / (double)RAND_MAX * 20 - 10; }
+
+signed main() {
+	srand(13);
+	rep(it,0,3000) {
+		int n = 4 + rand() % 10;
+		vector<P3> A(n);
+		for (auto& p : A) p = P3(rd(), rd(), rd());
+		vector<F> h = hull3d(A);
+		// brute force: faces are the triples with all other points on one side
+		set<array<int, 3>> bf, hf;
+		double vol = 0;
+		rep(i,0,n) rep(j,i+1,n) rep(k,j+1,n) {
+			P3 q = (A[j] - A[i]).cross(A[k] - A[i]);
+			int pos = 0, neg = 0;
+			rep(l,0,n) if (l != i && l != j && l != k)
+				(q.dot(A[l] - A[i]) > 0 ? pos : neg)++;
+			if (pos && neg) continue;
+			bf.insert({i, j, k});
+			vol += (pos ? -1 : 1) * A[i].cross(A[j]).dot(A[k]) / 6; // outward orientation
+		}
+		for (F& f : h) {
+			array<int, 3> t = {f.a, f.b, f.c}; sort(all(t));
+			assert(!hf.count(t)); hf.insert(t);
+			// outward: every point is on the inner side, and a, b, c is ccw seen from outside
+			rep(l,0,n) assert(f.q.dot(A[l] - A[f.a]) < 1e-9);
+			assert((A[f.b] - A[f.a]).cross(A[f.c] - A[f.a]).dot(f.q) > 0);
+		}
+		assert(hf == bf);
+		double v = signedPolyVolume(A, h);
+		assert(v > 0 && abs(v - vol) < 1e-6);
+	}
+	// volume of the unit cube, slightly perturbed so no four points are coplanar
+	vector<P3> C;
+	rep(m,0,8) C.push_back(P3(m & 1, m >> 1 & 1, m >> 2 & 1) + P3(rd(), rd(), rd()) * 1e-7);
+	assert(abs(signedPolyVolume(C, hull3d(C)) - 1) < 1e-5);
+	// Point3D
+	P3 x(1, 0, 0), y(0, 1, 0), z(0, 0, 1);
+	assert((x.rotate(M_PI / 2, z) - y).dist() < 1e-12); // ccw around the axis
+	assert((y.rotate(M_PI / 2, x) - z).dist() < 1e-12);
+	assert(x.cross(y) == z && abs(P3(3, 4, 12).dist() - 13) < 1e-12);
+	assert((x.normal(y) - z).dist() < 1e-12 && abs(P3(2, 3, 6).unit().dist() - 1) < 1e-12);
+	assert(abs(y.phi() - M_PI / 2) < 1e-12 && abs(P3(1, 0, sqrt(3)).theta() - M_PI / 6) < 1e-12);
+	// big input
+	vector<P3> B(2000);
+	for (auto& p : B) p = P3(rd(), rd(), rd());
+	vector<F> h = hull3d(B);
+	for (F& f : h) for (auto& p : B) assert(f.q.dot(p - B[f.a]) < 1e-9);
+	cout << "Tests passed!" << endl;
+}
diff --git a/stress-tests/geometry/CircleUnion.cpp b/stress-tests/geometry/CircleUnion.cpp
new file mode 100644
index 0000000..46c63ed
--- /dev/null
+++ b/stress-tests/geometry/CircleUnion.cpp
@@ -0,0 +1,83 @@
+#include "../utilities/template.h"
+
+#include "../../content/geometry/CircleUnion.h"
+
+// area by integrating over x: union of y-intervals, Gauss-Legendre per piece
+// between all critical x (circle ends, intersection points).
+double brute(vector<P>& c, vector<double>& r) {
+	int n = sz(c);
+	vector<double> xs;
+	rep(i,0,n) xs.push_back(c[i].x - r[i]), xs.push_back(c[i].x + r[i]);
+	rep(i,0,n) rep(j,0,i) {
+		double d = (c[i] - c[j]).dist();
+		if (d < 1e-12 || d > r[i] + r[j] || d < abs(r[i] - r[j])) continue;
+		double a = (r[i]*r[i] - r[j]*r[j] + d*d) / (2*d), h = sqrt(max(0.0, r[i]*r[i] - a*a));
+		P m = c[i] + (c[j] - c[i]) * (a / d), p = (c[j] - c[i]).perp() * (h / d);
+		xs.push_back((m + p).x), xs.push_back((m - p).x);
+	}
+	sort(all(xs));
+	auto f = [&](double x) {
+		vector<pair<double, double>> iv;
+		rep(i,0,n) if (abs(x - c[i].x) < r[i]) {
+			double h = sqrt(r[i]*r[i] - (x - c[i].x) * (x - c[i].x));
+			iv.push_back({c[i].y - h, c[i].y + h});
+		}
+		sort(all(iv));
+		double len = 0, cur = -1e18;
+		for (auto [l, h] : iv) { if (h > cur) len += h - max(l, cur), cur = h; }
+		return len;
+	};
+	// Gauss-Legendre (20 nodes, 4 sub-intervals) after x = a + (b-a)(1-cos t)/2,
+	// which removes the sqrt end singularities: the integrand is smooth in t
+	static vector<double> X, W;
+	if (X.empty()) rep(i,0,20) {
+		double z = cos(M_PI * (i + 0.75) / 20.5), pp = 0;
+		rep(it,0,100) {
+			double p1 = 1, p2 = 0;
+			rep(j,0,20) { double p3 = p2; p2 = p1; p1 = ((2*j + 1) * z * p2 - j * p3) / (j + 1); }
+			pp = 20 * (z * p1 - p2) / (z * z - 1);
+			z -= p1 / pp;
+		}
+		X.push_back(z), W.push_back(2 / ((1 - z * z) * pp * pp));
+	}
+	double res = 0;
+	rep(k,0,sz(xs)-1) {
+		double a = xs[k], b = xs[k+1];
+		if (b - a < 1e-12) continue;
+		rep(q,0,4) rep(i,0,20) {
+			double lo = q * M_PI / 4, t = lo + (X[i] + 1) * M_PI / 8;
+			res += W[i] * M_PI / 8 * f(a + (b - a) * (1 - cos(t)) / 2) * (b - a) * sin(t) / 2;
+		}
+	}
+	return res;
+}
+
+signed main() {
+	srand(11);
+	rep(it,0,3000) {
+		int n = rand() % 6 + 1, R = it % 2 ? 5 : 20;
+		vector<P> c; vector<double> r;
+		rep(i,0,n) {
+			if (i && rand() % 5 == 0) { // duplicate, concentric or tangent cases
+				int j = rand() % i;
+				c.push_back(c[j]);
+				r.push_back(rand() % 2 ? r[j] : (double)(rand() % R + 1));
+				continue;
+			}
+			c.push_back(P(rand() % (2 * R) - R, rand() % (2 * R) - R));
+			r.push_back(rand() % R + (it % 7 == 0 ? 0 : 1));
+		}
+		double a = circleUnion(c, r), b = brute(c, r);
+		if (abs(a - b) > 1e-6 * max(1.0, b)) {
+			cout << a << " " << b << endl;
+			rep(i,0,n) cout << c[i] << " " << r[i] << endl;
+			assert(0);
+		}
+	}
+	// exact checks
+	vector<P> c = {P(0, 0), P(0, 0), P(1, 0)}; vector<double> r = {1, 1, 1};
+	assert(abs(circleUnion(c, r) - (4 * M_PI / 3 + sqrt(3) / 2)) < 1e-9);
+	c = {P(0, 0), P(2, 0)}, r = {1, 1}; // tangent
+	assert(abs(circleUnion(c, r) - 2 * M_PI) < 1e-9);
+	cout << "Tests passed!" << endl;
+}
diff --git a/stress-tests/graph/ChromaticNumber.cpp b/stress-tests/graph/ChromaticNumber.cpp
new file mode 100644
index 0000000..45e8158
--- /dev/null
+++ b/stress-tests/graph/ChromaticNumber.cpp
@@ -0,0 +1,39 @@
+#include "../utilities/template.h"
+
+#include "../../content/graph/ChromaticNumber.h"
+
+int brute(int n, vi& adj) {
+	if (n == 0) return 0;
+	for (int k = 1;; k++) {
+		vi col(n);
+		// try all k^n colourings
+		ll total = 1; rep(i,0,n) total *= k;
+		rep(c,0,total) {
+			ll x = c;
+			rep(i,0,n) col[i] = (int)(x % k), x /= k;
+			bool ok = 1;
+			rep(i,0,n) rep(j,0,n) if (adj[i] >> j & 1 && col[i] == col[j]) ok = 0;
+			if (ok) return k;
+		}
+	}
+}
+
+signed main() {
+	srand(3);
+	rep(it,0,3000) {
+		int n = rand() % 8, p = rand() % 101;
+		vi adj(n);
+		rep(i,0,n) rep(j,0,i) if (rand() % 100 < p) adj[i] |= 1 << j, adj[j] |= 1 << i;
+		assert(chromatic(adj) == brute(n, adj));
+	}
+	// known graphs on 20 vertices
+	rep(k,1,21) { // complete graph K_k
+		vi adj(k); rep(i,0,k) adj[i] = ((1 << k) - 1) ^ (1 << i);
+		assert(chromatic(adj) == k);
+	}
+	vi cyc(19); rep(i,0,19) cyc[i] = 1 << (i + 1) % 19 | 1 << (i + 18) % 19;
+	assert(chromatic(cyc) == 3); // odd cycle
+	vi ev(20); rep(i,0,20) ev[i] = 1 << (i + 1) % 20 | 1 << (i + 19) % 20;
+	assert(chromatic(ev) == 2);
+	cout << "Tests passed!" << endl;
+}
diff --git a/stress-tests/graph/DominatorTree.cpp b/stress-tests/graph/DominatorTree.cpp
new file mode 100644
index 0000000..48a477b
--- /dev/null
+++ b/stress-tests/graph/DominatorTree.cpp
@@ -0,0 +1,49 @@
+#include "../utilities/template.h"
+
+#include "../../content/graph/DominatorTree.h"
+
+// reachable set from r when vertex `ban` is removed
+vector<bool> reach(vector<vi>& g, int r, int ban) {
+	vector<bool> vis(sz(g));
+	if (r == ban) return vis;
+	vi st = {r}; vis[r] = 1;
+	while (!st.empty()) {
+		int v = st.back(); st.pop_back();
+		for (int u : g[v]) if (u != ban && !vis[u]) vis[u] = 1, st.push_back(u);
+	}
+	return vis;
+}
+
+signed main() {
+	srand(7);
+	rep(it,0,20000) {
+		int n = rand() % 9 + 1, m = rand() % (3 * n + 1), r = rand() % n;
+		vector<vi> g(n);
+		rep(i,0,m) g[rand() % n].push_back(rand() % n); // loops and multi-edges too
+		vi idom = dominators(g, r);
+		vector<bool> all0 = reach(g, r, -1);
+		// D[v] = strict dominators of v
+		vector<vi> D(n);
+		rep(d,0,n) {
+			vector<bool> w = reach(g, r, d);
+			rep(v,0,n) if (v != d && all0[v] && !w[v]) D[v].push_back(d);
+		}
+		rep(v,0,n) {
+			if (!all0[v] || v == r) { assert(idom[v] == -1); continue; }
+			// idom = the strict dominator with the most strict dominators itself
+			int best = -1;
+			for (int d : D[v]) if (best < 0 || sz(D[d]) > sz(D[best])) best = d;
+			assert(sz(D[best]) == sz(D[v]) - 1);
+			assert(idom[v] == best);
+		}
+	}
+	// long path and big random graph: recursion depth and speed
+	int n = 200000;
+	vector<vi> g(n);
+	rep(i,0,n-1) g[i].push_back(i + 1);
+	vi idom = dominators(g, 0);
+	rep(i,1,n) assert(idom[i] == i - 1);
+	rep(i,0,n) rep(k,0,4) g[i].push_back(rand() % n);
+	dominators(g, 0);
+	cout << "Tests passed!" << endl;
+}
diff --git a/stress-tests/numerical/IntegrateAdaptive.cpp b/stress-tests/numerical/IntegrateAdaptive.cpp
