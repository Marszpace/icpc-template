+// TEST_MODS: 998244353 1000000007 7
+#include "../utilities/template.h"
+
+#include "../../content/numerical/SubsetConvolution.h"
+
+signed main() {
+	srand(5);
+	rep(it,0,300) {
+		int n = rand() % 8, N = 1 << n;
+		vector<ll> a(N), b(N);
+		rep(i,0,N) a[i] = rand() % mod, b[i] = rand() % mod;
+		if (it % 3 == 0) rep(i,0,N) a[i] = mod - 1, b[i] = mod - 1;
+		vector<ll> c = subsetConv(a, b), d(N);
+		rep(S,0,N) for (int T = S;; T = (T - 1) & S) {
+			d[S] = (d[S] + a[T] * b[S ^ T]) % mod;
+			if (!T) break;
+		}
+		assert(c == d);
+	}
+	// size 2^20 runs in time
+	int N = 1 << 20;
+	vector<ll> a(N), b(N);
+	rep(i,0,N) a[i] = rand() % mod, b[i] = rand() % mod;
+	vector<ll> c = subsetConv(a, b);
+	ll s = 0; rep(i,0,N) s += c[i];
+	cout << "Tests passed! " << s % 2 << endl;
+}
