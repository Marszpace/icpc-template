diff --git a/content/geometry/CircleUnion.h b/content/geometry/CircleUnion.h
new file mode 100644
index 0000000..9c76831
--- /dev/null
+++ b/content/geometry/CircleUnion.h
@@ -0,0 +1,46 @@
+/**
+ * Author: Claude
+ * Date: 2026-11-15
+ * License: CC0
+ * Source: Green's theorem over the uncovered arcs (folklore)
+ * Description: Area of the union of circles (centre $c_i$, radius $r_i \ge 0$). Identical circles count once.
+ * Time: O(N^2 \log N)
+ * Status: stress-tested
+ */
+#pragma once
+
+#include "Point.h"
+
+typedef Point<double> P;
+double circleUnion(vector<P>& c, vector<double>& r) {
+	int n = sz(c); double res = 0, e = 1e-9, pi = M_PI;
+	rep(i,0,n) {
+		P o = c[i]; double R = r[i]; bool in = 0;
+		vector<pair<double, double>> s; // covered arcs
+		rep(j,0,n) if (j != i) {
+			double d = (c[j] - o).dist(), q = r[j];
+			if (d + R < q + e && (j < i || R + e < d + q)) {
+				in = 1; break; // inside j; equal circles: keep first
+			}
+			if (d >= R + q || d + q < R + e) continue;
+			double a = (c[j] - o).angle(), w = acos(max(-1.0,
+				min(1.0, (R * R + d * d - q * q) / (2 * R * d))));
+			double lo = a - w, hi = a + w;
+			if (lo < -pi) s.push_back({lo + 2 * pi, pi}), lo = -pi;
+			if (hi > pi) s.push_back({-pi, hi - 2 * pi}), hi = pi;
+			s.push_back({lo, hi});
+		}
+		if (in) continue;
+		auto arc = [&](double x, double y) { // uncovered arc x..y
+			res += R * (R * (y - x) + o.x * (sin(y) - sin(x))
+				- o.y * (cos(y) - cos(x)));
+		};
+		sort(all(s)); double cur = -pi;
+		for (auto [l, h] : s) {
+			if (l > cur) arc(cur, l);
+			cur = max(cur, h);
+		}
+		if (cur < pi) arc(cur, pi);
+	}
+	return res / 2;
+}
