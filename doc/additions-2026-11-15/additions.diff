+++ b/stress-tests/numerical/IntegrateAdaptive.cpp
@@ -0,0 +1,34 @@
+#include "../utilities/template.h"
+
+#include "../../content/numerical/IntegrateAdaptive.h"
+
+signed main() {
+	srand(19);
+	auto near = [](double a, double b) { return abs(a - b) < 1e-6 * max(1.0, abs(b)); };
+	assert(near(quad(0, 1, [](double x) { return x * x; }), 1.0 / 3));
+	int cnt = 0; // adaptive: few evaluations on a smooth function (357 now)
+	assert(near(quad(0, M_PI, [&](double x) { cnt++; return sin(x); }), 2));
+	assert(cnt < 1000);
+	assert(near(quad(-1, 2, [](double x) { return abs(x - 0.3); }), (1.3 * 1.3 + 1.7 * 1.7) / 2));
+	assert(near(quad(0, 1, [](double x) { return sqrt(x); }), 2.0 / 3));
+	assert(near(quad(-5, 5, [](double x) { return exp(-x * x); }), sqrt(M_PI) * erf(5)));
+	assert(near(quad(-1, 1, [](double x) { return 2 * sqrt(max(0.0, 1 - x * x)); }), M_PI));
+	// kink in the middle of a big interval: max of two lines
+	assert(near(quad(0, 10, [](double x) { return max(x, 7.3); }), 7.3 * 7.3 + (100 - 7.3 * 7.3) / 2));
+	// nested: area of the unit disk as a double integral of an indicator-free function
+	double disk = quad(-1, 1, [&](double x) {
+		double h = sqrt(max(0.0, 1 - x * x));
+		return quad(-h, h, [](double) { return 1.0; }); });
+	assert(near(disk, M_PI));
+	// random polynomials
+	rep(it,0,1000) {
+		int deg = rand() % 7; vector<double> p(deg + 1);
+		for (auto& v : p) v = rand() % 21 - 10;
+		double a = rand() % 11 - 5, b = a + rand() % 6 + 1, ex = 0;
+		rep(i,0,deg+1) ex += p[i] * (pow(b, i + 1) - pow(a, i + 1)) / (i + 1);
+		double got = quad(a, b, [&](double x) {
+			double s = 0; for (int i = deg; i >= 0; i--) s = s * x + p[i]; return s; });
+		assert(near(got, ex));
+	}
+	cout << "Tests passed!" << endl;
+}
diff --git a/stress-tests/numerical/Simplex.cpp b/stress-tests/numerical/Simplex.cpp
new file mode 100644
index 0000000..c482de5
--- /dev/null
+++ b/stress-tests/numerical/Simplex.cpp
@@ -0,0 +1,72 @@
+#include "../utilities/template.h"
+
+#include "../../content/numerical/Simplex.h"
+
+// Brute force: best vertex of {Ax <= b, x >= 0, x <= box}. A bounded LP with these small
+// integers has its vertices well inside the box; an unbounded one grows with the box.
+T brute(vvd& A, vd& b, vd& c, double box) {
+	int n = sz(c);
+	vvd R = A; vd rhs = b;
+	rep(i,0,n) {
+		vd e(n); e[i] = -1; R.push_back(e); rhs.push_back(0);
+		e[i] = 1; R.push_back(e); rhs.push_back(box);
+	}
+	int K = sz(R); T best = -inf;
+	rep(mask,0,1 << K) if (__builtin_popcount(mask) == n) {
+		vvd M; vd y;
+		rep(i,0,K) if (mask >> i & 1) M.push_back(R[i]), y.push_back(rhs[i]);
+		// Gauss-Jordan
+		bool sing = 0;
+		rep(col,0,n) {
+			int p = col;
+			rep(r,col,n) if (abs(M[r][col]) > abs(M[p][col])) p = r;
+			if (abs(M[p][col]) < 1e-9) { sing = 1; break; }
+			swap(M[p], M[col]); swap(y[p], y[col]);
+			rep(r,0,n) if (r != col) {
+				double f = M[r][col] / M[col][col];
+				rep(k,0,n) M[r][k] -= f * M[col][k];
+				y[r] -= f * y[col];
+			}
+		}
+		if (sing) continue;
+		vd x(n); rep(i,0,n) x[i] = y[i] / M[i][i];
+		bool ok = 1;
+		rep(i,0,K) {
+			double s = 0; rep(j,0,n) s += R[i][j] * x[j];
+			if (s > rhs[i] + 1e-7) ok = 0;
+		}
+		if (!ok) continue;
+		double v = 0; rep(j,0,n) v += c[j] * x[j];
+		best = max(best, v);
+	}
+	return best;
+}
+
+signed main() {
+	srand(17);
+	int cnt[3] = {};
+	rep(it,0,20000) {
+		int n = rand() % 3 + 1, m = rand() % 5;
+		vvd A(m, vd(n)); vd b(m), c(n);
+		for (auto& r : A) for (auto& v : r) v = rand() % 7 - 3;
+		for (auto& v : b) v = rand() % 11 - 5;
+		for (auto& v : c) v = rand() % 7 - 3;
+		vd x;
+		T val = LPSolver(A, b, c).solve(x);
+		T b1 = brute(A, b, c, 1e3), b2 = brute(A, b, c, 2e3);
+		if (b1 == -inf) { assert(val == -inf); cnt[0]++; continue; }
+		if (b2 > b1 + 1e-6) { assert(val == inf); cnt[1]++; continue; }
+		cnt[2]++;
+		assert(abs(val - b1) < 1e-6);
+		// x is feasible and reaches the value
+		double s = 0; rep(j,0,n) s += c[j] * x[j], assert(x[j] > -1e-7);
+		assert(abs(s - val) < 1e-6);
+		rep(i,0,m) { double t = 0; rep(j,0,n) t += A[i][j] * x[j]; assert(t < b[i] + 1e-7); }
+	}
+	assert(cnt[0] > 100 && cnt[1] > 100 && cnt[2] > 1000);
+	// the usage example: min x + y with x - y <= 1, y - x <= 1, x + 2y >= 4: x = 2/3, y = 5/3
+	vvd A = {{1,-1}, {-1,1}, {-1,-2}};
+	vd b = {1,1,-4}, c = {-1,-1}, x;
+	assert(abs(LPSolver(A, b, c).solve(x) + 7.0 / 3) < 1e-9 && abs(x[0] - 2.0 / 3) < 1e-9);
+	cout << "Tests passed! " << cnt[0] << " " << cnt[1] << " " << cnt[2] << endl;
+}
