diff --git a/content/numerical/SubsetConvolution.h b/content/numerical/SubsetConvolution.h
new file mode 100644
index 0000000..ea5067c
--- /dev/null
+++ b/content/numerical/SubsetConvolution.h
@@ -0,0 +1,28 @@
+/**
+ * Author: Claude
+ * Date: 2026-11-15
+ * License: CC0
+ * Source: ranked zeta transform (folklore)
+ * Description: $c[S] = \sum_{T \subseteq S} a[T] \, b[S \setminus T]$ modulo \texttt{mod}.
+ * Sizes $2^n$, values in $[0, mod)$.
+ * Time: O(2^N N^2)
+ * Status: stress-tested
+ */
+#pragma once
+
+vector<ll> subsetConv(vector<ll> a, vector<ll> b) {
+	int N = sz(a), n = __builtin_ctzll(N);
+	vector<vector<ll>> A(n + 1, vector<ll>(N)), B = A, C = A;
+	auto pc = [](int m) { return __builtin_popcountll(m); };
+	auto zeta = [&](vector<ll>& f, ll s) { // s = -1: inverse
+		rep(i,0,n) rep(m,0,N) if (m >> i & 1)
+			f[m] = (f[m] + s * f[m ^ 1 << i]) % mod;
+	};
+	rep(m,0,N) A[pc(m)][m] = a[m], B[pc(m)][m] = b[m];
+	rep(k,0,n+1) zeta(A[k], 1), zeta(B[k], 1);
+	rep(k,0,n+1) rep(i,0,k+1) rep(m,0,N)
+		C[k][m] = (C[k][m] + A[i][m] * B[k - i][m]) % mod;
+	rep(k,0,n+1) zeta(C[k], mod - 1);
+	rep(m,0,N) a[m] = C[pc(m)][m];
+	return a;
+}
