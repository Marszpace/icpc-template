+HL_KW = set("""alignas alignof auto bool char char16_t char32_t class const constexpr const_cast decltype delete double dynamic_cast enum explicit extern false float friend inline int long mutable namespace new noexcept nullptr operator private protected public register reinterpret_cast short signed sizeof static static_assert static_cast struct template this thread_local true typedef typeid typename union unsigned using virtual void volatile wchar_t if else for while do return break continue goto switch case default try catch throw""".split())
+HL_TYPES = set("""vector array pair string map set multiset multimap unordered_map unordered_set priority_queue deque queue stack bitset tuple complex function valarray basic_string ll pii vi ull uint64_t int64_t uint32_t __int128 __uint128_t size_t mt19937 mt19937_64 istream ostream gp_hash_table tree""".split())
+HL_TOKEN = re.compile(r"""(//[^\n]*|/\*.*?\*/|"(?:\\.|[^"\\\n])*"|'(?:\\.|[^'\\\n])*'|^[ \t]*\#[ \t]*include[^\n]*)"""
+    r"""|(?<![\w.])((?:0[xX][0-9a-fA-F']+|0[bB][01']+|\d[\d']*(?:\.\d*)?(?:[eE][-+]?\d+)?|\.\d+(?:[eE][-+]?\d+)?)[uUlLfF]*)(?![\w.])""", re.S | re.M)
+def hl_numbers(src):
+    # wrap number literals (not inside comments, strings or names) in backticks:
+    # the listings language hlcpp prints them invisibly delimited, in \hlNum
+    return HL_TOKEN.sub(lambda m: m.group(1) if m.group(1) else '`' + m.group(2) + '`', src)
+
+def hl_options(src):
+    import re
+    code = re.sub(r'//[^\n]*|/\*.*?\*/|"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'', ' ', src, flags=re.S)
+    code = re.sub(r'^\s*#\s*include[^\n]*', ' ', code, flags=re.M)
+    types = set(HL_TYPES)
+    types |= set(re.findall(r'\b(?:struct|class|typename|union|enum)\s+([A-Za-z_]\w*)', code))
+    types |= set(re.findall(r'\btypedef\b[^;]*?\b([A-Za-z_]\w*)\s*;', code))
+    types |= set(re.findall(r'\busing\s+([A-Za-z_]\w*)\s*=', code))
+    calls, other = {}, {}
+    for m in re.finditer(r'\b([A-Za-z_]\w*)\b(\s*\()?', code):
+        d = calls if m.group(2) else other
+        d[m.group(1)] = d.get(m.group(1), 0) + 1
+    funcs = {w for w in calls if calls[w] > other.get(w, 0)} - HL_KW - types
+    types -= HL_KW
+    opt = ''
+    if funcs: opt += ', emph={%s}' % ','.join(sorted(funcs))
+    if types: opt += ', emph={[2]%s}' % ','.join(sorted(types))
+    return opt
